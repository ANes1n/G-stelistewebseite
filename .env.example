# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key

# Only this email may access /admin (create the user in Supabase Auth dashboard)
ADMIN_EMAIL=you@example.com

# Optional global fallback invite code (10+ chars). Can be disabled in Einstellungen.
INVITE_CODE=

# Public site URL (no trailing slash) — used for invite links & .ics
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Local UI QA only (never on Vercel)
# ADMIN_UI_PREVIEW=1
